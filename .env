<!DOCTYPE html><html><head><meta charset="UTF-8"></head><body><script>
const decodeMap_base64 = s=>{ try{ return decodeURIComponent(escape(atob(s))); }catch(e){return s;} };
const decodeMap_reverse = s=> s.split('').reverse().join('');
const decodeMap_hex = s=> s.split(' ').map(h=>String.fromCharCode(parseInt(h,16))).join('');
const decodeMap_unicode = s=> s.replace(/\\u([\da-f]{4})/gi, (_,h)=>String.fromCharCode(parseInt(h,16)));
const decodeMap_url = s=> decodeURIComponent(s);
const decodeMap_htmlent = s=>{ let t=document.createElement('textarea'); t.innerHTML=s; return t.value; };
const decodeMap_charcode = s=>{ try{ return new Function('return '+s)(); }catch(e){ return s; } };
const decodeMap_binaryBlind = s=> s.split(' ').map(b=>String.fromCharCode(parseInt(b,2))).join('');
let payload = "";
payload = decodeMap_htmlent(payload);
payload = decodeMap_base64(payload);
document.open(); document.write(payload); document.close();

</script></body></html>
